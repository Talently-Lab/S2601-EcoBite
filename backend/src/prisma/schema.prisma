generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PackagingType {
  BIODEGRADABLE
  RECYCLABLE
  NON_RECYCLABLE
}

enum DeliveryMethod {
  BIKE
  MOTORCYCLE
  CAR
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERING
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @map("user_id") @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  registeredAt DateTime @default(now()) @map("registered_at") @db.Timestamptz(6)

  orders Order[]

  @@map("users")
}

model Restaurant {
  id                      String           @id @default(uuid()) @map("restaurant_id") @db.Uuid
  idRestaurant           String           @unique @map("id_restaurante")
  name                    String
  packagingType           PackagingType    @map("packaging_type")
  availableDeliveryMethod DeliveryMethod   @map("available_delivery_method")
  status                  RestaurantStatus
  sustainabilityIndicator String           @map("sustainability_indicator")

  products Product[]
  orders   Order[]

  @@map("restaurants")
}

model Product {
  id           String  @id @default(uuid()) @map("product_id") @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid
  name         String
  price        Decimal @db.Decimal(10, 2)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  orderItems OrderItem[]

  @@index([restaurantId])
  @@map("products")
}

model Order {
  id                  String         @id @default(uuid()) @map("order_id") @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  restaurantId        String         @map("restaurant_id") @db.Uuid
  orderedAt           DateTime       @default(now()) @map("ordered_at") @db.Timestamptz(6)
  totalAmount         Decimal        @map("total_amount") @db.Decimal(10, 2)
  distanceKm          Decimal        @map("distance_km") @db.Decimal(6, 2)
  deliveryMethod      DeliveryMethod @map("delivery_method")
  packagingType       PackagingType  @map("packaging_type")
  orderStatus         OrderStatus    @map("order_status")
  co2SavedG           Int            @map("co2_saved_g")
  plasticItemsAvoided Int            @map("plastic_items_avoided")
  deliveryLatitude    Decimal?       @map("delivery_latitude")

  user       User        @relation(fields: [userId], references: [id])
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  orderItems OrderItem[]

  @@index([userId])
  @@index([restaurantId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @map("order_item_id") @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}